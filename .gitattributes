# Shell scripts and systemd units must keep LF on every platform: a CRLF
# shebang makes /bin/sh fail with "bad interpreter: ^M" on Linux.
* text=auto eol=lf

*.sh       text eol=lf
*.service  text eol=lf
*.tmpfiles text eol=lf
*.py       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
